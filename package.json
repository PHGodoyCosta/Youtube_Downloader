{
    "name": "youtube-downloader",
    "version": "1.0.2",
    "description": "Programa para conversão e download de músicas e playlists do youtube",
    "main": "./public/main.js",
    "homepage": "./",
    "scripts": {
        "start": "npx electron .",
        "build:server:win": "python -m PyInstaller --onefile --add-data=\"server/yt_dlp_conversor.py:.\" --icon=server/mg.ico --exclude-module PySide6 server/server.py",
        "postbuild:server:win": "cd dist & rename server.exe server_mg_conversor.exe & move server_mg_conversor.exe \"../server/server_mg_conversor.exe\"",
        "build": "electron-builder"
    },
    "author": "Pedro Henrique Godoy Costa",
    "license": "MIT",
    "build": {
        "appId": "com.mgconversor.electron",
        "asar": true,
        "asarUnpack": [
            "server/**/*",
            "dist/"
        ],
        "files": [
            "public/**/*",
            "server/**/*",
            "dist/server_mg_conversor.exe"
        ],
        "publish": null,
        "productName": "Conversor Mg Multicoisas",
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "extraFiles": [
                {
                    "from": "dist/server_mg_conversor.exe",
                    "to": "server/server_mg_conversor.exe"
                }
            ],
            "icon": "public/static/images/mg.ico"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "public/static/images/mg.png"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "public/static/images/mg.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "${productName}-Setup-${version}.exe"
        },
        "directories": {
            "buildResources": "."
        }
    },
    "devDependencies": {
        "electron": "^32.1.2",
        "electron-builder": "^25.1.7"
    }
}
